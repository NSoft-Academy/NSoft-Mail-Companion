NODE_ENV=production
WEB_URL=https://panel.example.com
MAIL_HOSTNAME=mail.example.com
PUBLIC_IPV4=203.0.113.10
POSTGRES_PASSWORD=REPLACE_BOOTSTRAP_SECRET
MIGRATION_DB_PASSWORD=REPLACE_MIGRATION_SECRET
APP_DB_PASSWORD=REPLACE_APP_SECRET
MAIL_DB_PASSWORD=REPLACE_MAIL_SECRET
ROUNDCUBE_DB_PASSWORD=REPLACE_ROUNDCUBE_SECRET
ENCRYPTION_KEY=REPLACE_ENCRYPTION_SECRET
ROUNDCUBE_DES_KEY=REPLACE_WITH_24_RANDOM_CHARACTERS
DATABASE_URL=postgresql://nsoft_runtime:REPLACE_APP_SECRET@localhost:5432/mailcompanion
INTERNAL_API_URL=http://api:4000
REQUIRE_MFA=true
ACME_EMAIL=admin@example.com
# Optional: zone-scoped DNS edit permission; do not proxy mail A records.
# CLOUDFLARE_TOKEN=
# Optional global authenticated relay on port 587 (no silent fallback).
# SMTP_RELAY_HOST=smtp.provider.example
# SMTP_RELAY_USERNAME=
# SMTP_RELAY_PASSWORD=
# SMTP_RELAY_SPF=spf.provider.example
# ALERT_WEBHOOK=https://your-monitor.example/hook
# BACKUP: export separately to the administrator shell, never commit.
# RESTIC_REPOSITORY=s3:https://s3.example.com/bucket/mail-backups
# RESTIC_PASSWORD=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional Cloudflare DNS-01 for mail-protocol certificates:
# ACME_DNS_PROVIDER=dns_cf
# ACME_DNS_TOKEN=
# ACME_DNS_ZONE_ID=
# Required when using compose.backup.yaml:
# NSOFT_BACKUP_ROOT=/srv/nsoft-mail
