compatibility_level = 3.6
myhostname = __MAIL_HOSTNAME__
myorigin = $myhostname
mydestination = localhost
inet_interfaces = all
inet_protocols = ipv4
mynetworks = 127.0.0.0/8
smtp_helo_name = $myhostname
smtpd_banner = $myhostname ESMTP
smtpd_tls_cert_file = /data/tls/fullchain.pem
smtpd_tls_key_file = /data/tls/privkey.pem
smtpd_tls_security_level = may
smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtp_tls_security_level = may
smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt
smtp_tls_loglevel = 1
smtpd_relay_restrictions = permit_sasl_authenticated, reject_unauth_destination
smtpd_recipient_restrictions = reject_non_fqdn_recipient, reject_unknown_recipient_domain, reject_unlisted_recipient
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_auth_enable = no
smtpd_sasl_security_options = noanonymous
smtpd_tls_auth_only = yes
virtual_mailbox_domains = pgsql:/etc/postfix/pgsql-domains.cf
virtual_mailbox_maps = pgsql:/etc/postfix/pgsql-mailboxes.cf
virtual_alias_maps = pgsql:/etc/postfix/pgsql-aliases.cf
virtual_transport = lmtp:unix:private/dovecot-lmtp
smtpd_sender_login_maps = pgsql:/etc/postfix/pgsql-senders.cf
smtpd_milters = inet:rspamd:11332
non_smtpd_milters = inet:rspamd:11332
milter_default_action = tempfail
milter_protocol = 6
message_size_limit = 26214400
smtpd_client_connection_count_limit = 20
smtpd_client_connection_rate_limit = 60
smtpd_client_message_rate_limit = 100
smtpd_client_event_limit_exceptions =
smtpd_forbid_unauth_pipelining = yes
maillog_file = /dev/stdout
alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases
smtpd_peername_lookup = no
